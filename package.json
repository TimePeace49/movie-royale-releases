{
  "name": "movie-royal",
  "version": "1.38.1",
  "description": "Battle royal movie wheel for Twitch: Discord suggestions, Letterboxd, custom lists, channel points and bits.",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node src/server.js",
    "desktop": "electron .",
    "build:win": "node scripts/build-win.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "express": "^4.21.1",
    "socket.io-client": "^2.5.0",
    "ws": "^8.18.0"
  },
  "productName": "Movie Royal",
  "author": "Derek Viera",
  "devDependencies": {
    "7zip-bin": "^5.2.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "pe-library": "^1.0.1",
    "resedit": "^2.0.3"
  },
  "build": {
    "appId": "com.movieroyal.app",
    "productName": "Movie Royal",
    "executableName": "MovieRoyal",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "desktop/**/*",
      "PATCHNOTES.md",
      "CHANGELOG.md",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  },
  "updateRepo": "",
  "license": "MIT"
}
